# Zugriffsschluessel der Bewerbungsseite /cv/<key>.
# Lokal in .env.local setzen, in Produktion als Vercel Environment Variable.
# Ohne Wert ist nur /cv/preview erreichbar.
CV_ACCESS_KEY=

# Kontaktformular (/api/contact) — ausschliesslich serverseitig, NIE mit NEXT_PUBLIC_.
# API-Key aus dem Resend-Dashboard (Sending access fuer die Domain genuegt).
RESEND_API_KEY=
# Absender, muss zu einer bei Resend verifizierten Domain gehoeren,
# z. B.: NuVio Labs Website <website@nuviolabs.de>
CONTACT_FROM_EMAIL=
# Optional: Empfaenger der Anfragen. Ohne Wert gilt CONTACT_EMAIL aus lib/site.ts.
CONTACT_EMAIL=
